# Copy to .env. The schema lives in src/env.js.

DATABASE_URL="postgresql://user:password@localhost:5432/link2it"

# 32+ characters. Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=""

# Optional. Without these, Google sign-in is hidden. In Google Cloud, add
# https://<domain>/api/auth/callback/google as a redirect URI for every domain.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Origins this deployment answers on, comma separated, the first being primary.
# Seeds Admin → Domains on first boot; after that domains live in the database.
NEXT_PUBLIC_DOMAINS="http://localhost:3000"
