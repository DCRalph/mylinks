# Copy to .env. The schema lives in src/env.js.

DATABASE_URL="postgresql://user:password@localhost:5432/link2it"

# 32+ characters. Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=""

# Optional. Without these, Google sign-in is hidden. In Google Cloud, add
# https://<domain>/api/auth/callback/google as a redirect URI for every domain below.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Every origin this deployment answers on, comma separated. Each one serves the
# whole app (sign-in included) and every short link. The first is the default.
NEXT_PUBLIC_DOMAINS="http://localhost:3000"
