// Existing databases are brought up to date at server start by
// src/server/migrations.ts. A new database starts with `prisma db push`.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// Auth tables, owned by better-auth (src/server/auth.ts).

model User {
  id            String   @id @default(cuid())
  createdAt     DateTime @default(now())
  updatedAt     DateTime @default(now()) @updatedAt
  name          String
  email         String   @unique
  emailVerified Boolean  @default(false)
  image         String?

  username     String? @unique
  requireSetup Boolean @default(true)
  flags        String?

  // Comma-separated roles from src/lib/permissions.ts, e.g. "user,pixels".
  role       String    @default("user")
  banned     Boolean   @default(false)
  banReason  String?
  banExpires DateTime?

  accounts       Account[]
  sessions       Session[]
  Links          Link[]
  Profiles       Profile[]
  SpyPixels      SpyPixel[]
  bookmarks      Bookmark[]
  bookmarkFolder BookmarkFolder[]
  bookmarkTags   BookmarkTag[]
  auditLogs      AuditLog[]
}

model Session {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
  token     String   @unique
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Set while an admin is viewing the app as this user.
  impersonatedBy String?

  @@index([userId])
}

model Account {
  id                    String    @id @default(cuid())
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @default(now()) @updatedAt
  // "google", or "credential" for email + password.
  providerId            String
  accountId             String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?

  @@unique([providerId, accountId])
  @@index([userId])
}

model Verification {
  id         String   @id @default(cuid())
  createdAt  DateTime @default(now())
  updatedAt  DateTime @default(now()) @updatedAt
  identifier String
  value      String
  expiresAt  DateTime

  @@index([identifier])
}

// App tables.

model Link {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String

  name String
  slug String @unique
  url  String

  clicks Click[]

  @@index([userId])
}

model Profile {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String

  name    String
  altName String?
  slug    String  @unique
  bio     String?

  profileLinks ProfileLink[]

  // JSON array of ProfileLink ids, in display order.
  linkOrder String

  clicks Click[]

  @@index([userId])
}

model ProfileLink {
  id String @id @default(cuid())

  profile   Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  profileId String

  visible Boolean @default(true)

  title       String
  url         String
  description String?
  iconUrl     String?
  bgColor     String?
  fgColor     String?
}

model SpyPixel {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String

  name String
  slug String @unique

  clicks Click[]
}

// One row per short link hit, profile view, or spy pixel load.
model Click {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  linkId String?
  link   Link?   @relation(fields: [linkId], references: [id], onDelete: Cascade)

  profileId String?
  profile   Profile? @relation(fields: [profileId], references: [id], onDelete: Cascade)

  spyPixelId String?
  spyPixel   SpyPixel? @relation(fields: [spyPixelId], references: [id], onDelete: Cascade)

  userAgent  String?
  ipAddress  String?
  referer    String?
  allHeaders String?

  @@index([linkId])
  @@index([profileId, createdAt])
  @@index([spyPixelId])
}

model BookmarkFolder {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String

  type  String @default("folder")
  name  String
  color String @default("#000000")

  // The root folder has no parent.
  parentFolder   BookmarkFolder?  @relation("Subfolders", fields: [parentFolderId], references: [id], onDelete: Cascade)
  parentFolderId String?
  subfolders     BookmarkFolder[] @relation("Subfolders")

  bookmarks Bookmark[]
}

model Bookmark {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String

  folder   BookmarkFolder @relation(fields: [folderId], references: [id], onDelete: Cascade)
  folderId String

  tags BookmarkTag[]

  name  String
  url   String
  color String @default("#000000")
}

model BookmarkTag {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  bookmark   Bookmark? @relation(fields: [bookmarkId], references: [id], onDelete: Cascade)
  bookmarkId String?

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String

  name String
}

// Who did what in the admin console. Kept when the actor is deleted.
model AuditLog {
  id         String   @id @default(cuid())
  createdAt  DateTime @default(now())
  actorId    String?
  actor      User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)
  // Dotted verb, e.g. "user.ban", "domain.add".
  action     String
  targetType String?
  targetId   String?
  // One line a person can read: "Banned new_user_88 until Nov 8".
  summary    String
  details    Json?

  @@index([createdAt])
  @@index([actorId])
}

// Platform: domains, settings and better-auth's rate limits.

enum DomainStatus {
  pending
  active
  disabled
}

// Hosts this deployment answers on, managed in Admin → Domains. Only active
// domains serve the app (src/proxy.ts); pending ones answer the verify check.
model Domain {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Lowercase, with a port only in development: "l2.it", "localhost:3000".
  host     String       @unique
  // "https", or "http" for local development.
  protocol String       @default("https")
  status   DomainStatus @default(pending)
  // Used for new sessions, the landing page and copied links by default.
  // Exactly one active domain is primary.
  primary  Boolean      @default(false)

  verifiedAt DateTime?
  checkedAt  DateTime?
  // Why the last verify check failed.
  checkError String?
}

// A single row (id 1). `data` is validated and defaulted by src/server/settings.ts.
model PlatformSettings {
  id        Int      @id @default(1)
  updatedAt DateTime @updatedAt
  data      Json
}

// better-auth's rate limit counters, so limits survive restarts.
model RateLimit {
  id          String @id
  key         String @unique
  count       Int
  lastRequest BigInt
}
